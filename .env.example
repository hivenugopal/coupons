# Copy to .env for `vercel dev`, or paste these names/values in
# Vercel → Project → Settings → Environment Variables.

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DB_SCHEMA=coupons
DB_TABLE=gc_coupons
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ALLOWED_COUPON_HOSTS=offers.greatclips.com
